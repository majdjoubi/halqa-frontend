{
  "version": 2,
  "public": false,
  "buildCommand": "npm run build",
  "devCommand": "ng serve",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "dist/halqa/browser",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/images/logo.png"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "/assets/images/logo.png"
    },
    {
      "src": "/apple-touch-icon-precomposed.png",
      "dest": "/assets/images/logo.png"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://halqa-api-k60w.onrender.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://halqa-api-k60w.onrender.com/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
