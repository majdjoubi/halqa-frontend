{
  "version": 2,
  "public": false,
  "buildCommand": "npm run build",
  "devCommand": "ng serve",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "dist/halqa/browser",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/gifts/vouchers/((?:GFT_[A-Za-z0-9_-]+)|(?:HALQA[A-Za-z0-9]{5}))/redeem$",
      "dest": "/api/gifts/vouchers/redeem?code=$1"
    },
    {
      "src": "/api/gifts/vouchers/((?:GFT_[A-Za-z0-9_-]+)|(?:HALQA[A-Za-z0-9]{5}))$",
      "dest": "/api/gifts/vouchers/get?code=$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/images/logo.png"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "/assets/images/logo.png"
    },
    {
      "src": "/apple-touch-icon-precomposed.png",
      "dest": "/assets/images/logo.png"
    },
    {
      "src": "/api/(?!admin/messaging|unsubscribe|health|gifts)(.*)",
      "dest": "https://halqa-api-k60w.onrender.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://halqa-api-k60w.onrender.com/uploads/$1"
    },
    {
      "src": "/hubs/(.*)",
      "dest": "https://halqa-api-k60w.onrender.com/hubs/$1"
    },
    {
      "src": "/v2/(.*)",
      "dest": "https://halqa-api-k60w.onrender.com/v2/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
