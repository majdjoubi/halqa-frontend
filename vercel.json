{
  "version": 2,
  "public": false,
  "buildCommand": "npm run build",
  "devCommand": "ng serve",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "dist/halqa/browser",
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/images/logo.png"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/assets/images/logo.png"
    },
    {
      "source": "/apple-touch-icon-precomposed.png",
      "destination": "/assets/images/logo.png"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://halqa-api-k60w.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://halqa-api-k60w.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
