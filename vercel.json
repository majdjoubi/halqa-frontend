{
  "version": 2,
  "public": false,
  "buildCommand": "npm run build",
  "devCommand": "ng serve",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "dist/halqa/browser",
  "crons": [
    {
      "path": "/api/admin/messaging/worker/run",
      "schedule": "*/1 * * * *"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/assets/i18n/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/images/logo.png"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "/assets/images/logo.png"
    },
    {
      "src": "/apple-touch-icon-precomposed.png",
      "dest": "/assets/images/logo.png"
    },
    {
      "src": "/api/(?!admin/messaging|unsubscribe|health)(.*)",
      "dest": "https://halqa-api-k60w.onrender.com/api/$1"
    },
    {
      "src": "/v1/(.*)",
      "dest": "https://halqa-api-k60w.onrender.com/v1/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://halqa-api-k60w.onrender.com/uploads/$1"
    },
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "no-store"
      },
      "dest": "/index.html"
    }
  ]
}
